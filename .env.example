# Copy to .env and fill in your own values.
# The application imports this file automatically at startup
# (see spring.config.import in src/main/resources/application.yaml).
# Values set in the real environment always take precedence over .env.

# Google AI Studio / Gemini API key used for chat completions and embeddings.
GENAI_API_KEY=your-genai-api-key-here

# Optional overrides
# GOOGLE_GENAI_CHAT_MODEL=gemini-3.1-flash-lite
# GOOGLE_GENAI_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_GENAI_TEMPERATURE=0.2
